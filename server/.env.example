# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGIN=https://manualdoempregador.com.br,http://localhost:5173

# ──────────────────────────────────────────────────────────────
# PostgreSQL
# Running inside the same Docker network as evolution-postgres:
#   postgresql://postgres:<senha>@evolution-postgres:5432/postgres
# Running via SSH tunnel from outside the VPS:
#   postgresql://postgres:<senha>@localhost:5432/postgres
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:difyai123456@evolution-postgres:5432/postgres

# ──────────────────────────────────────────────────────────────
# Admin auth - secret used to hash e-mail login codes and sessions
# Gere com:  openssl rand -hex 32
# ──────────────────────────────────────────────────────────────
ADMIN_AUTH_SECRET=

# ──────────────────────────────────────────────────────────────
# Mercado Pago — backend only (NUNCA expor ao frontend)
# ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-2783696014404921-040913-0ed54f2433d7cfaeeed31575daf942d8-3201432
SITE_URL=https://manualdoempregador.com.br

# ──────────────────────────────────────────────────────────────
# Resend — e-mails transacionais (compra aprovada)
# Crie em https://resend.com/api-keys
# ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Manual do Empregador <noreply@manualempregador.com.br>

# ──────────────────────────────────────────────────────────────
# MinIO — storage do PDF do e-book
# Instância na própria VPS (porta 9003)
# ──────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://157.173.118.98:9003
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio1234
MINIO_REGION=us-east-1
