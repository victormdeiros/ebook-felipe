PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://manualdoempregador.com.br,http://localhost:8080
SITE_URL=https://manualdoempregador.com.br

# Connected Supabase project, confirmed through MCP.
SUPABASE_PROJECT_REF=heusjcoijobbsgzyfupm
SUPABASE_URL=https://heusjcoijobbsgzyfupm.supabase.co
SUPABASE_STORAGE_BUCKET=ebook-manual

# Backend only. Copy the exact connection string from Supabase > Connect.
# Prefer the Supavisor transaction pooler for Vercel.
# Direct example: postgresql://postgres:<URL_ENCODED_PASSWORD>@db.heusjcoijobbsgzyfupm.supabase.co:5432/postgres
# Pooler username: postgres.heusjcoijobbsgzyfupm.
# The MCP does not return the database password.
DATABASE_URL=
# Optional PEM certificate from Supabase for verified TLS.
DATABASE_SSL_CA=

# Backend only, from Supabase > Settings > API Keys.
# MCP returns public keys only; never use VITE_ for private credentials.
SUPABASE_SECRET_KEY=
# Legacy alternative:
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_AUTH_SECRET=
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
RESEND_API_KEY=
EMAIL_FROM=Manual do Empregador <noreply@manualempregador.com.br>

# Protects /api/cron/email-queue (external scheduler on Vercel).
CRON_SECRET=
