# ─────────────────────────────────────────────────────────────────
# Supabase (obrigatório para Mercado Pago e persistência de leads)
# Crie um projeto em https://supabase.com e cole os valores abaixo
# ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────
# Mercado Pago — Frontend
#
# VITE_MP_SANDBOX=true   → usa sandbox_init_point (testes)
# VITE_MP_SANDBOX=false  → usa init_point (produção)
# ─────────────────────────────────────────────────────────────────
VITE_MP_SANDBOX=false

# ─────────────────────────────────────────────────────────────────
# Mercado Pago — Edge Function (secrets — NÃO commitar no git)
#
# Configure via Supabase CLI (nunca no .env do frontend):
#   supabase secrets set MP_ACCESS_TOKEN=APP_USR-...
#   supabase secrets set SITE_URL=https://manualdoempregador.com.br
#
# Obtenha o Access Token em:
#   https://www.mercadopago.com.br/settings/account/credentials
# ─────────────────────────────────────────────────────────────────
